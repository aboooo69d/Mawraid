# -----------------------------------------------------------------------------
# Mawarid Go backend — environment configuration (PLACEHOLDERS ONLY)
#
# ⚠️ This file contains NO real credentials. Copy it to `.env` (git-ignored)
#    and fill in real values there. Never commit real secrets.
#    Never hardcode production credentials, passwords, or API keys in code.
# -----------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# HTTP server
HTTP_ADDR=:8080
# Public base path for all versioned API routes.
API_BASE_PATH=/api/v1
# Comma-separated list of allowed browser origins (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Server-side timeouts (seconds) for reading requests / writing responses.
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=30

# --- PostgreSQL ---------------------------------------------------------------
# Local dev (docker compose up -d):
DATABASE_URL=postgres://mawarid:mawarid_dev_password@localhost:5432/mawarid?sslmode=disable
# Set to "true" ONLY for local development to run GORM AutoMigrate on boot.
DATABASE_AUTO_MIGRATE=true
# Maximum number of open database connections.
DATABASE_MAX_OPEN_CONNS=10

# --- Redis --------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# When "true", the backend runs WITHOUT Redis using an in-process fallback
# (useful on machines where Docker is unavailable). Rate limiting still works
# but is not shared across processes. Never enable in production.
REDIS_DISABLED=false

# --- Security -----------------------------------------------------------------
# REQUIRED in production: 64-char random hex (openssl rand -hex 32).
# The server REFUSES to start with the default value when APP_ENV=production.
JWT_SECRET=dev-only-insecure-change-me-000000000000000000000000000000
# JWT access token lifetime.
JWT_ACCESS_TTL_MINUTES=15
# Refresh/session lifetime (days).
JWT_REFRESH_TTL_DAYS=14

# --- Password hashing (argon2id) ----------------------------------------------
# Defaults are the OWASP-recommended Argon2id parameters; override only with care.
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=2
ARGON2_KEY_LEN=32
ARGON2_SALT_LEN=16

# --- OTP (SRS NFR-SEC-04: validity 2–5 minutes from request) ------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=5
# Minimum seconds between OTP resend requests for the same phone+purpose
# (SRS FR-AUTH-01: 60 seconds).
OTP_RESEND_COOLDOWN_SECONDS=60
# Maximum OTP resend requests per phone+purpose within the TTL window.
OTP_RESEND_MAX_PER_WINDOW=5
# SRS NFR-SEC-03: maximum verification attempts per code.
OTP_MAX_ATTEMPTS=3

# --- Demo phone verification (LOCAL DEMO ONLY — refused in production) ---------
# When "true", the freshly generated OTP is echoed back in the
# /auth/register/* and /auth/otp/request responses as `dev_otp_code`, so a
# local demo can complete phone verification WITHOUT any SMS provider.
# SECURITY: no universal/hardcoded code — each code stays random, single-use,
# hashed at rest, with the same TTL/attempt/cooldown limits. The server
# REFUSES TO START when APP_ENV=production and this is true, so production
# verification always requires real SMS. Leave false for normal development.
DEMO_PHONE_VERIFICATION=false

# --- Login attempt limiting (SRS URS 1.3 / NFR-SEC-03) ------------------------
# Lock the account login for LOGIN_LOCKOUT_WINDOW_MINUTES after this many
# consecutive failed attempts (SRS: 5 attempts → 15 minutes).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# --- Document upload -----------------------------------------------------------
# Maximum accepted upload size in bytes (5 MiB).
MAX_UPLOAD_SIZE_BYTES=5242880
# Directory where uploaded identity documents are stored (created on demand).
# MUST be writable and must NOT be publicly served.
UPLOAD_DIR=./data/uploads

# --- SMS provider ---------------------------------------------------------------
# sms_provider: dev | http
#   dev  = development adapter: logs OTP to server console/file ONLY, never sent.
#   http = generic HTTP SMS gateway adapter (URL/key come from the real provider
#          when it is supplied — NOT implemented against a real provider yet).
SMS_PROVIDER=dev
SMS_FROM_LABEL=Mawarid
# SMS_HTTP_URL=
# SMS_HTTP_API_KEY=
# SMS_HTTP_SENDER_ID=

# --- First-admin bootstrap (optional) ------------------------------------------
# Creates the first admin account at startup on an EMPTY database.
# Leave ADMIN_BOOTSTRAP_PHONE empty (or commented out) to skip.
# Rules enforced by the server:
#   - PHONE must be a valid Yemeni number (7XXXXXXXX, 07XXXXXXXX, +967...);
#   - PASSWORD is REQUIRED whenever PHONE is set — no default credentials;
#   - skipped entirely when an admin account already exists;
#   - the phone/password are NEVER logged.
# Remove these values after the first successful start.
# ADMIN_BOOTSTRAP_PHONE=7XXXXXXXX
# ADMIN_BOOTSTRAP_NAME=Mawarid Admin
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Observability ---------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
