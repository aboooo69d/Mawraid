# Server
PORT=8080
GIN_MODE=debug

# PostgreSQL (Podman localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nova
DB_SSLMODE=disable

# Redis (Podman localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloudflare R2
BUCKET_NAME=your_bucket_name
ACCOUNT_ID=your_account_id
ACCESS_KEY_ID=your_access_key_id
ACCESS_KEY_SECRET=your_access_key_secret

# AES-256 File Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
