# -----------------------------------------------------------------------------
# Mawarid frontend — environment configuration (PLACEHOLDERS ONLY)
#
# ⚠️ This file contains NO real credentials. Copy it to `.env.local` (git-ignored)
#    and fill in real values there. Never commit real secrets.
#
# By default, variables WITHOUT the `NEXT_PUBLIC_` prefix are read exclusively
# on the server (Server Components / Route Handlers) and never inlined into the
# browser bundle. The single intentional exception below (NEXT_PUBLIC_API_BASE_URL)
# exposes only the backend's public API origin — never a secret.
# NEVER add `NEXT_PUBLIC_` to tokens, passwords, API keys, or database URLs.
# -----------------------------------------------------------------------------

# Base URL of the Go backend (GORM/PostgreSQL/Redis).
# Server-only (no NEXT_PUBLIC_ prefix). Used by the server-side data client
# lib/api/client.ts and available to the same-origin proxy route at
# app/api/v1/[...path]/route.ts (kept for server-side use; the auth module no
# longer routes through it — auth calls the public URL below directly).
#   Examples: http://localhost:8080/api/v1  |  https://api.example.com/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# PUBLIC backend URL used by the BROWSER-SIDE auth client (lib/auth/api.ts).
# The auth module issues direct cross-origin requests with
# `credentials: 'include'` so the Go backend's HttpOnly `session` cookie is
# sent and stored by the browser (cookies are owned by the backend — Next.js
# never manages them). The backend must therefore allow this origin in CORS
# with `Access-Control-Allow-Credentials: true`.
#   Examples: http://localhost:8080/api/v1  |  https://api.example.com/api/v1
# TODO(BACKEND-URL): temporary configuration — the FINAL backend URL will be
# provided by the backend developer. Never hardcode a production URL in code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional: request timeout for lib/api/client.ts, in milliseconds.
# Leave unset to use the built-in default (10000 ms).
API_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# NOTE: no auth token/key is needed here. Citizen auth uses the backend's
# cookie-based session flow (POST /auth/login sets an HttpOnly `session`
# cookie owned by the Go backend / Redis). The browser stores the cookie
# automatically on credentialed requests; the frontend never holds tokens and
# Next.js never generates or manages authentication cookies.
# -----------------------------------------------------------------------------
